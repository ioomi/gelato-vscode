    "quickInputList.focusForeground": "#E0D9CE",
    "pickerGroup.border": "#363230",
    "pickerGroup.foreground": "#91B2CC",
    "gitDecoration.addedResourceForeground": "#9DBB8C",
    "gitDecoration.modifiedResourceForeground": "#D49E7B",
    "gitDecoration.deletedResourceForeground": "#D58E87",
    "gitDecoration.renamedResourceForeground": "#8DBCB7",
    "gitDecoration.untrackedResourceForeground": "#AEC99B",
    "gitDecoration.ignoredResourceForeground": "#66605B",
    "gitDecoration.conflictingResourceForeground": "#D5C27F",
    "gitDecoration.submoduleResourceForeground": "#91B2CC",
