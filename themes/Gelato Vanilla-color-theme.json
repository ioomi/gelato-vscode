    "peekViewResult.fileForeground": "#E0D9CE",
    "peekViewResult.lineForeground": "#9A938B",
    "peekViewResult.matchHighlightBackground": "#D5C27F35",
    "peekViewResult.selectionBackground": "#363230",
    "peekViewTitle.background": "#2A2725",
    "peekViewTitleDescription.foreground": "#9A938B",
    "peekViewTitleLabel.foreground": "#E0D9CE",
    "panel.background": "#211E1D",
    "panel.border": "#363230",
    "panelTitle.activeBorder": "#91B2CC",
    "panelTitle.activeForeground": "#E0D9CE",
    "panelTitle.inactiveForeground": "#9A938B",
    "statusBar.background": "#2A2725",
    "statusBar.foreground": "#D0CAC0",
    "statusBar.border": "#363230",
    "statusBar.debuggingBackground": "#D49E7B",
    "statusBar.debuggingForeground": "#211E1D",
    "statusBar.noFolderBackground": "#363230",
    "statusBar.noFolderForeground": "#D0CAC0",
    "statusBarItem.activeBackground": "#EEE7DC18",
    "statusBarItem.hoverBackground": "#EEE7DC10",
    "statusBarItem.errorBackground": "#D58E87",
    "statusBarItem.errorForeground": "#211E1D",
    "statusBarItem.warningBackground": "#D5C27F",
    "statusBarItem.warningForeground": "#211E1D",
    "titleBar.activeBackground": "#2A2725",
    "titleBar.activeForeground": "#E0D9CE",
    "titleBar.inactiveBackground": "#2A2725",
    "titleBar.inactiveForeground": "#66605B",
    "titleBar.border": "#363230",
    "menu.background": "#2A2725",
    "menu.foreground": "#D0CAC0",
    "menu.selectionBackground": "#363230",
    "menu.selectionForeground": "#E0D9CE",
    "menu.separatorBackground": "#363230",
    "menubar.selectionBackground": "#363230",
    "menubar.selectionForeground": "#E0D9CE",
    "notificationCenter.border": "#363230",
