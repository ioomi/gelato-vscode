    "terminal.foreground": "#D0CAC0",
    "terminal.selectionBackground": "#91B2CC40",
    "terminalCursor.background": "#211E1D",
    "terminalCursor.foreground": "#D5CEA9",
    "terminal.ansiBlack": "#211E1D",
    "terminal.ansiRed": "#D58E87",
    "terminal.ansiGreen": "#9DBB8C",
    "terminal.ansiYellow": "#D5C27F",
    "terminal.ansiBlue": "#91B2CC",
    "terminal.ansiMagenta": "#AF9AC4",
    "terminal.ansiCyan": "#8DBCB7",
    "terminal.ansiWhite": "#D0CAC0",
    "terminal.ansiBrightBlack": "#77706A",
    "terminal.ansiBrightRed": "#E3A29A",
    "terminal.ansiBrightGreen": "#AEC99B",
    "terminal.ansiBrightYellow": "#E4D192",
    "terminal.ansiBrightBlue": "#A3C1DA",
    "terminal.ansiBrightMagenta": "#BEABD2",
    "terminal.ansiBrightCyan": "#9DCAC5",
    "terminal.ansiBrightWhite": "#EEE7DC"
