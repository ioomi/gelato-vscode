  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#D0CAC0"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#66605B"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable.name",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#D0CAC0"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D0CAC0"
      }
    },
    {
      "name": "Numbers, booleans, and constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#AF9AC4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D5C27F"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "variable.interpolation"
      ],
      "settings": {
        "foreground": "#D0CAC0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D58E87"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#D58E87"
      }
    },
    {
      "name": "Preprocessor macros",
      "scope": [
        "entity.name.function.preprocessor",
        "constant.other.preprocessor",
        "support.constant.macro"
      ],
      "settings": {
        "foreground": "#AF9AC4"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.namespace",
        "punctuation.accessor.namespace"
      ],
      "settings": {
        "foreground": "#D49E7B"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9DBB8C"
      }
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "support.module",
        "variable.other.module"
      ],
      "settings": {
        "foreground": "#8DBCB7"
      }
    },
    {
      "name": "Types, classes, and traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.type.trait"
      ],
      "settings": {
        "foreground": "#91B2CC"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D58E87"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#D58E87"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#91B2CC"
      }
    },
    {
      "name": "Labels and special symbols",
      "scope": [
        "entity.name.label",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#AF9AC4"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E3A29A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#66605B"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#91B2CC"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "foreground": "#D58E87"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic",
        "markup.italic string"
      ],
      "settings": {
        "foreground": "#AF9AC4"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#8DBCB7"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#D5C27F"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#66605B"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#9DBB8C"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#D49E7B"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#D58E87"
      }
    },
    {
      "name": "Gelato global bold",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "invalid",
        "invalid.illegal",
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown",
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8DBCB7",
    "type": "#91B2CC",
    "class": "#91B2CC",
    "enum": "#91B2CC",
    "interface": "#91B2CC",
    "struct": "#91B2CC",
    "typeParameter": "#91B2CC",
    "parameter": "#D0CAC0",
    "variable": "#D0CAC0",
    "property": "#D0CAC0",
    "enumMember": "#AF9AC4",
    "event": "#9DBB8C",
    "function": "#9DBB8C",
    "method": "#9DBB8C",
    "macro": "#AF9AC4",
    "macro:c": "#AF9AC4",
    "macro:cpp": "#AF9AC4",
    "label": "#AF9AC4",
    "comment": "#66605B",
    "string": "#D5C27F",
    "keyword": "#D58E87",
    "number": "#AF9AC4",
    "regexp": "#D5C27F",
    "operator": "#D49E7B",
    "decorator": "#D58E87",
    "variable.readonly": "#AF9AC4",
    "property.readonly": "#D0CAC0",
    "*.deprecated": {
      "foreground": "#66605B",
      "strikethrough": true
    },
    "*.declaration": {
      "bold": true
    }
  }
}
