    "notificationsInfoIcon.foreground": "#899EAF",
    "quickInput.background": "#292624",
    "quickInput.foreground": "#C7C1B7",
    "quickInputList.focusBackground": "#34302D",
    "quickInputList.focusForeground": "#D5CFC5",
    "pickerGroup.border": "#34302D",
    "pickerGroup.foreground": "#899EAF",
    "gitDecoration.addedResourceForeground": "#91A482",
    "gitDecoration.modifiedResourceForeground": "#BE9478",
    "gitDecoration.deletedResourceForeground": "#BD8580",
    "gitDecoration.renamedResourceForeground": "#84A19D",
    "gitDecoration.untrackedResourceForeground": "#A0B190",
    "gitDecoration.ignoredResourceForeground": "#5E5A55",
    "gitDecoration.conflictingResourceForeground": "#BCAE7A",
    "gitDecoration.submoduleResourceForeground": "#899EAF",
    "terminal.background": "#211E1D",
    "terminal.foreground": "#C7C1B7",
    "terminal.selectionBackground": "#899EAF40",
    "terminalCursor.background": "#211E1D",
    "terminalCursor.foreground": "#C3BDA0",
    "terminal.ansiBlack": "#211E1D",
    "terminal.ansiRed": "#BD8580",
    "terminal.ansiGreen": "#91A482",
    "terminal.ansiYellow": "#BCAE7A",
    "terminal.ansiBlue": "#899EAF",
    "terminal.ansiMagenta": "#9D8FAA",
    "terminal.ansiCyan": "#84A19D",
    "terminal.ansiWhite": "#C7C1B7",
    "terminal.ansiBrightBlack": "#6E6963",
    "terminal.ansiBrightRed": "#CA9791",
    "terminal.ansiBrightGreen": "#A0B190",
    "terminal.ansiBrightYellow": "#C9BC8A",
    "terminal.ansiBrightBlue": "#98ACBC",
    "terminal.ansiBrightMagenta": "#AB9CB8",
    "terminal.ansiBrightCyan": "#93AFAB",
    "terminal.ansiBrightWhite": "#E3DDD2"
  },
  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#C7C1B7"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5E5A55"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable.name",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#C7C1B7"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#C7C1B7"
      }
    },
    {
      "name": "Numbers, booleans, and constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9D8FAA"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#BCAE7A"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "variable.interpolation"
      ],
      "settings": {
        "foreground": "#C7C1B7"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#BD8580"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#BD8580"
      }
    },
    {
      "name": "Preprocessor macros",
      "scope": [
        "entity.name.function.preprocessor",
        "constant.other.preprocessor",
        "support.constant.macro"
      ],
      "settings": {
        "foreground": "#9D8FAA"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.namespace",
        "punctuation.accessor.namespace"
      ],
      "settings": {
        "foreground": "#BE9478"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#91A482"
      }
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "support.module",
        "variable.other.module"
      ],
      "settings": {
        "foreground": "#84A19D"
      }
    },
    {
      "name": "Types, classes, and traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.type.trait"
      ],
      "settings": {
        "foreground": "#899EAF"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#BD8580"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#BD8580"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#899EAF"
      }
    },
    {
      "name": "Labels and special symbols",
      "scope": [
        "entity.name.label",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#9D8FAA"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#CA9791"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#5E5A55"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#899EAF"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "foreground": "#BD8580"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic",
        "markup.italic string"
      ],
      "settings": {
        "foreground": "#9D8FAA"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#84A19D"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#BCAE7A"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#5E5A55"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#91A482"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#BE9478"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#BD8580"
      }
    },
    {
      "name": "Gelato global bold",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "invalid",
        "invalid.illegal",
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown",
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#84A19D",
    "type": "#899EAF",
    "class": "#899EAF",
    "enum": "#899EAF",
    "interface": "#899EAF",
    "struct": "#899EAF",
    "typeParameter": "#899EAF",
    "parameter": "#C7C1B7",
    "variable": "#C7C1B7",
    "property": "#C7C1B7",
    "enumMember": "#9D8FAA",
    "event": "#91A482",
    "function": "#91A482",
    "method": "#91A482",
    "macro": "#9D8FAA",
    "macro:c": "#9D8FAA",
    "macro:cpp": "#9D8FAA",
    "label": "#9D8FAA",
    "comment": "#5E5A55",
    "string": "#BCAE7A",
    "keyword": "#BD8580",
    "number": "#9D8FAA",
    "regexp": "#BCAE7A",
    "operator": "#BE9478",
    "decorator": "#BD8580",
    "variable.readonly": "#9D8FAA",
    "property.readonly": "#C7C1B7",
    "*.deprecated": {
      "foreground": "#5E5A55",
      "strikethrough": true
    },
    "*.declaration": {
      "bold": true
    }
  }
}
