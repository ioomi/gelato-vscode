    "peekViewResult.background": "#292624",
    "peekViewResult.fileForeground": "#D5CFC5",
    "peekViewResult.lineForeground": "#918B83",
    "peekViewResult.matchHighlightBackground": "#BCAE7A35",
    "peekViewResult.selectionBackground": "#34302D",
    "peekViewTitle.background": "#292624",
    "peekViewTitleDescription.foreground": "#918B83",
    "peekViewTitleLabel.foreground": "#D5CFC5",
    "panel.background": "#211E1D",
    "panel.border": "#34302D",
    "panelTitle.activeBorder": "#899EAF",
    "panelTitle.activeForeground": "#D5CFC5",
    "panelTitle.inactiveForeground": "#918B83",
    "statusBar.background": "#292624",
    "statusBar.foreground": "#C7C1B7",
    "statusBar.border": "#34302D",
    "statusBar.debuggingBackground": "#BE9478",
    "statusBar.debuggingForeground": "#211E1D",
    "statusBar.noFolderBackground": "#34302D",
    "statusBar.noFolderForeground": "#C7C1B7",
    "statusBarItem.activeBackground": "#E3DDD218",
    "statusBarItem.hoverBackground": "#E3DDD210",
    "statusBarItem.errorBackground": "#BD8580",
    "statusBarItem.errorForeground": "#211E1D",
    "statusBarItem.warningBackground": "#BCAE7A",
    "statusBarItem.warningForeground": "#211E1D",
    "titleBar.activeBackground": "#292624",
    "titleBar.activeForeground": "#D5CFC5",
    "titleBar.inactiveBackground": "#292624",
    "titleBar.inactiveForeground": "#5E5A55",
    "titleBar.border": "#34302D",
    "menu.background": "#292624",
    "menu.foreground": "#C7C1B7",
    "menu.selectionBackground": "#34302D",
    "menu.selectionForeground": "#D5CFC5",
    "menu.separatorBackground": "#34302D",
    "menubar.selectionBackground": "#34302D",
    "menubar.selectionForeground": "#D5CFC5",
    "notificationCenter.border": "#34302D",
    "notificationCenterHeader.background": "#292624",
    "notificationCenterHeader.foreground": "#D5CFC5",
    "notifications.background": "#292624",
    "notifications.border": "#34302D",
    "notifications.foreground": "#C7C1B7",
    "notificationLink.foreground": "#899EAF",
    "notificationsErrorIcon.foreground": "#BD8580",
