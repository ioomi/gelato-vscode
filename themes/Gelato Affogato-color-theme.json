    "quickInput.background": "#292929",
    "quickInput.foreground": "#D8D4C8",
    "quickInputList.focusBackground": "#373634",
    "quickInputList.focusForeground": "#E9E4D7",
    "pickerGroup.border": "#373634",
    "pickerGroup.foreground": "#9FC7EA",
    "gitDecoration.addedResourceForeground": "#A8CC91",
    "gitDecoration.modifiedResourceForeground": "#EAAF84",
    "gitDecoration.deletedResourceForeground": "#E99B91",
    "gitDecoration.renamedResourceForeground": "#99D5CE",
    "gitDecoration.untrackedResourceForeground": "#BDDEA9",
    "gitDecoration.ignoredResourceForeground": "#686661",
    "gitDecoration.conflictingResourceForeground": "#F2D98B",
    "gitDecoration.submoduleResourceForeground": "#9FC7EA",
