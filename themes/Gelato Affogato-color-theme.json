    "terminal.foreground": "#D8D4C8",
    "terminal.selectionBackground": "#9FC7EA40",
    "terminalCursor.background": "#202020",
    "terminalCursor.foreground": "#E0DAB9",
    "terminal.ansiBlack": "#202020",
    "terminal.ansiRed": "#E99B91",
    "terminal.ansiGreen": "#A8CC91",
    "terminal.ansiYellow": "#F2D98B",
    "terminal.ansiBlue": "#9FC7EA",
    "terminal.ansiMagenta": "#C5AFE2",
    "terminal.ansiCyan": "#99D5CE",
    "terminal.ansiWhite": "#D8D4C8",
    "terminal.ansiBrightBlack": "#77736D",
    "terminal.ansiBrightRed": "#F3B1A7",
    "terminal.ansiBrightGreen": "#BDDEA9",
    "terminal.ansiBrightYellow": "#F8E5A2",
    "terminal.ansiBrightBlue": "#B8D8F3",
    "terminal.ansiBrightMagenta": "#D8C4ED",
    "terminal.ansiBrightCyan": "#AFE5DF",
    "terminal.ansiBrightWhite": "#F7F1E3"
  },
  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#D8D4C8"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686661"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable.name",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#D8D4C8"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D8D4C8"
      }
    },
    {
      "name": "Numbers, booleans, and constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#C5AFE2"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F2D98B"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "variable.interpolation"
      ],
      "settings": {
        "foreground": "#D8D4C8"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E99B91"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.namespace",
        "punctuation.accessor.namespace"
      ],
      "settings": {
        "foreground": "#EAAF84"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#A8CC91"
      }
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "support.module",
        "variable.other.module"
      ],
      "settings": {
        "foreground": "#99D5CE"
      }
    },
    {
      "name": "Types, classes, and traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.type.trait"
      ],
      "settings": {
        "foreground": "#9FC7EA"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#E99B91"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E99B91"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#9FC7EA"
      }
    },
    {
      "name": "Labels and special symbols",
      "scope": [
        "entity.name.label",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#C5AFE2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F3B1A7"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#686661"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#9FC7EA"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "foreground": "#E99B91"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic",
        "markup.italic string"
      ],
      "settings": {
        "foreground": "#C5AFE2"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#99D5CE"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#F2D98B"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#686661"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#A8CC91"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#EAAF84"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#E99B91"
      }
    },
    {
      "name": "Gelato global bold",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "invalid",
        "invalid.illegal",
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown",
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#99D5CE",
    "type": "#9FC7EA",
    "class": "#9FC7EA",
    "enum": "#9FC7EA",
    "interface": "#9FC7EA",
    "struct": "#9FC7EA",
    "typeParameter": "#9FC7EA",
    "parameter": "#D8D4C8",
    "variable": "#D8D4C8",
    "property": "#D8D4C8",
    "enumMember": "#C5AFE2",
    "event": "#A8CC91",
    "function": "#A8CC91",
    "method": "#A8CC91",
    "macro": "#A8CC91",
    "label": "#C5AFE2",
    "comment": "#686661",
    "string": "#F2D98B",
    "keyword": "#E99B91",
    "number": "#C5AFE2",
    "regexp": "#F2D98B",
    "operator": "#EAAF84",
    "decorator": "#E99B91",
    "variable.readonly": "#C5AFE2",
    "property.readonly": "#D8D4C8",
    "*.deprecated": {
      "foreground": "#686661",
      "strikethrough": true
    },
    "*.declaration": {
      "bold": true
    }
  }
}
