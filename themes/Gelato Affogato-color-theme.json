    "peekViewResult.lineForeground": "#A09D95",
    "peekViewResult.matchHighlightBackground": "#F2D98B35",
    "peekViewResult.selectionBackground": "#373634",
    "peekViewTitle.background": "#292929",
    "peekViewTitleDescription.foreground": "#A09D95",
    "peekViewTitleLabel.foreground": "#E9E4D7",
    "panel.background": "#202020",
    "panel.border": "#373634",
    "panelTitle.activeBorder": "#9FC7EA",
    "panelTitle.activeForeground": "#E9E4D7",
    "panelTitle.inactiveForeground": "#A09D95",
    "statusBar.background": "#292929",
    "statusBar.foreground": "#D8D4C8",
    "statusBar.border": "#373634",
    "statusBar.debuggingBackground": "#EAAF84",
    "statusBar.debuggingForeground": "#202020",
    "statusBar.noFolderBackground": "#373634",
    "statusBar.noFolderForeground": "#D8D4C8",
    "statusBarItem.activeBackground": "#F7F1E318",
    "statusBarItem.hoverBackground": "#F7F1E310",
    "statusBarItem.errorBackground": "#E99B91",
    "statusBarItem.errorForeground": "#202020",
    "statusBarItem.warningBackground": "#F2D98B",
    "statusBarItem.warningForeground": "#202020",
    "titleBar.activeBackground": "#292929",
    "titleBar.activeForeground": "#E9E4D7",
    "titleBar.inactiveBackground": "#292929",
    "titleBar.inactiveForeground": "#686661",
    "titleBar.border": "#373634",
    "menu.background": "#292929",
    "menu.foreground": "#D8D4C8",
    "menu.selectionBackground": "#373634",
    "menu.selectionForeground": "#E9E4D7",
    "menu.separatorBackground": "#373634",
    "menubar.selectionBackground": "#373634",
    "menubar.selectionForeground": "#E9E4D7",
    "notificationCenter.border": "#373634",
    "notificationCenterHeader.background": "#292929",
    "notificationCenterHeader.foreground": "#E9E4D7",
    "notifications.background": "#292929",
